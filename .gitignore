# whitelist: code and text only (weights, latents, videos, metrics, logs, envs stay out)
*
!*/
!.gitignore
!*.py
!*.sh
!*.md
!*.txt
!*.json
!*.yaml
!*.toml
!*.cfg
!*.npz
# heavy / generated / third-party trees
archive/
outputs/
hf/
venv/
h3world/
mig/
exp/
third_party/
stevo_bench_code/
specwm_out/
specwm_out_web/
inputs/
logs/
sdv2_latency/
wan21_official/
VisionReward/
likephys/
hands_action/
b1/
h3/
cuda*/
data/*/
!data/stevo/
data/stevo/*/
tools/*/
!tools/abot/
tools/abot/*/
lingbot-world-v2/lingbot-world-v2-*/
lingbot-world-v2/bid_as_v1_cam/
lingbot-world-v2/specwm_out/
lingbot-world-v2/examples/
lingbot-world-v2/.git/
lingbot-world/lingbot-world-*/
lingbot-world/specwm_out/
lingbot-world/.git/
baselines/raw/
baselines/runs/
baselines/metrics*/
baselines/logs/
baselines/scenes/
baselines/tasks/*/
baselines/gen/logs/
baselines/gen/queue/
baselines/gen/sentinels/
