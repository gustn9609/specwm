baselines/*/raw/
baselines/*/logs/
paper/*/videos/
paper/*/figs/
paper/*/blind*/
paper/overnight/
**/__pycache__/
**/*.log
**/*.pt
**/*.pth
**/*.safetensors
**/*.mp4
**/*.png
**/*.jpg
**/*.npy
**/*.csv
**/*.tsv
.torch_hub/
lingbot-world-v2/.git_upstream_off/
lingbot-world/.git_upstream_off/
tools/abot/.git_upstream_off/
get-pip.py
